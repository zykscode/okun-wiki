# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Neon (recommended for Vercel): postgresql://user:pass@host/dbname?sslmode=require
# Local:                          postgresql://postgres:postgres@localhost:5432/okunpedia
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okunpedia"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Comma-separated Prisma cuid()s of users who always have admin access
ADMIN_USER_IDS=""
# Email used when running the seed script
ADMIN_SEED_EMAIL="admin@okunpedia.com"

# ─── OAuth Providers (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Uploadthing ──────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=""
