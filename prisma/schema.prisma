// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole      @default(USER)
  status        AccountStatus @default(ACTIVE)
  bio           String?
  location      String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  isApprovedWriter Boolean    @default(false)
  mentorshipTracks MentorshipTrack[] @relation("UserMentorshipTracks")

  accounts      Account[]
  sessions      Session[]
  createdTowns  Town[]        @relation("TownCreator")
  comments      Comment[]
  blogPosts     BlogPost[]
  activities    ActivityLog[]

  // Social features
  communities   UserCommunity[]
  updates       CommunityUpdate[]
  mentoring     Mentorship[]      @relation("MentorRelation")
  mentoredBy    Mentorship[]      @relation("MenteeRelation")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// TOWNS & GEOGRAPHY
// ============================================

model Town {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  tagline     String?

  state       String   @default("Kogi")
  lga         String
  coordinates String?

  population  Int?
  founded     String?

  overview    String

  metaDescription String?

  published   Boolean  @default(false)
  featured    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("TownCreator", fields: [createdById], references: [id])
  createdById String

  pages       TownPage[]
  festivals   Festival[]
  people      ProminentPerson[]
  images      TownImage[]
  comments    Comment[]
  amenities   SocialAmenity[]
  needs       TownNeed[]
  families    FamilyLineage[]
  neighbors   NeighboringTown[] @relation("TownToNeighbor")
  neighborOf  NeighboringTown[] @relation("NeighborToTown")

  @@index([slug])
  @@index([published])
  @@index([featured])
}

model SocialAmenity {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  
  name        String
  type        String   // e.g. "Hospital", "School", "Water", "Electricity", "Market"
  status      String   // e.g. "Available", "Functional", "Dilapidated", "Under Construction"
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
}

model TownNeed {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  
  category    String   // e.g. "Infrastructure", "Education", "Healthcare", "Security"
  description String
  urgency     String   // e.g. "High", "Medium", "Low"
  status      String   @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
}

model FamilyLineage {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  
  name        String
  history     String
  headOfFamily String?
  prominentMembers String? // Can be comma-separated list or JSON

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
}

model NeighboringTown {
  id          String   @id @default(cuid())
  
  townId      String
  town        Town     @relation("TownToNeighbor", fields: [townId], references: [id], onDelete: Cascade)
  
  neighborId  String
  neighbor    Town     @relation("NeighborToTown", fields: [neighborId], references: [id], onDelete: Cascade)
  
  direction   String?  // e.g. "North", "South", "East", "West"
  distanceKm  Float?

  @@unique([townId, neighborId])
  @@index([townId])
  @@index([neighborId])
}

enum PageType {
  HISTORY
  CULTURE
  GEOGRAPHY
  ECONOMY
  CUSTOM
}

model TownPage {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)

  type        PageType
  title       String
  slug        String
  content     String

  published   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    PageVersion[]
  comments    Comment[]

  @@unique([townId, slug])
  @@index([townId])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        TownPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  content     String
  editSummary String?
  version     Int

  createdAt   DateTime @default(now())
  createdBy   String

  @@index([pageId])
}

// ============================================
// CULTURAL CONTENT
// ============================================

model Festival {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)

  name        String
  description String
  period      String
  significance String

  images      FestivalImage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
}

model ProminentPerson {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)

  name        String
  title       String?
  role        String
  biography   String

  birthYear   Int?
  deathYear   Int?
  isAlive     Boolean  @default(true)

  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
}

model TownImage {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)

  url         String
  caption     String?
  credit      String?

  isPrimary   Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([townId])
}

// ============================================
// BLOG & ARTICLES
// ============================================

enum BlogCategory {
  NEWS
  CULTURE
  HISTORY
  OPINION
  EVENTS
  EDUCATION
  DEVELOPMENT
  GENERAL
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     String
  coverImage  String?

  category    BlogCategory @default(GENERAL)
  tags        Tag[]        @relation("BlogPostTags")

  published   Boolean      @default(false)
  featured    Boolean      @default(false)
  views       Int          @default(0)

  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([published])
  @@index([authorId])
  @@index([category])
}

// ============================================
// COMMUNITY FEATURES
// ============================================

model Comment {
  id          String   @id @default(cuid())
  content     String

  townId      String?
  town        Town?    @relation(fields: [townId], references: [id], onDelete: Cascade)

  pageId      String?
  page        TownPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  approved    Boolean  @default(true)
  flagged     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([townId])
  @@index([pageId])
  @@index([authorId])
  @@index([parentId])
}

// ============================================
// ADMIN & SETTINGS
// ============================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  updatedAt DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action    String   // e.g. "created_town", "edited_page", "published_post"
  target    String   // e.g. "town:kabba", "post:my-article"
  details   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// COMMUNITIES & SOCIAL
// ============================================

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  region      String?
  whatsappLink  String?
  telegramLink  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     UserCommunity[]
  updates     CommunityUpdate[]
  mentorships Mentorship[]
}

model UserCommunity {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  joinedAt    DateTime @default(now())
  role        String   @default("MEMBER") // MENTOR, MENTEE, MEMBER, ADMIN

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model CommunityUpdate {
  id          String   @id @default(cuid())
  content     String
  isSOS       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String
  communityId String

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
}

model Mentorship {
  id          String   @id @default(cuid())
  communityId String
  mentorId    String?
  menteeId    String?
  status      String   @default("PENDING") // PENDING, ACTIVE, COMPLETED, REJECTED
  goal        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  mentor      User?     @relation("MentorRelation", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee      User?     @relation("MenteeRelation", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId, communityId])
  @@index([communityId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  posts BlogPost[] @relation("BlogPostTags")
}

model MentorshipTrack {
  id    String @id @default(cuid())
  name  String @unique
  users User[] @relation("UserMentorshipTracks")
}

model FestivalImage {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([festivalId])
}
